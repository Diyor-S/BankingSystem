<mxfile host="app.diagrams.net"><diagram name="Life cycle" id="d1"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="1500" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c2" value="SmartBank (SB-2026): software life cycle (Agile / Scrum iterations)" style="text;html=1;fontSize=16;fontStyle=1;align=center;" vertex="1" parent="1"><mxGeometry x="60" y="10" width="900" height="30" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;1. Requirements &amp;amp; planning&lt;/b&gt; &amp;nbsp;&amp;nbsp;&lt;font color='#E65100'&gt;◄ CURRENT STAGE&lt;/font&gt;&lt;br&gt;Charter, interviews with customers and bank staff, 11 User Stories, FR/NFR list, Technical Specification, Kick-off page" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;fillColor=#FFE0B2;strokeColor=#E65100;strokeWidth=4;" vertex="1" parent="1"><mxGeometry x="60" y="60" width="460" height="110" as="geometry"/></mxCell><mxCell id="c4" value="CLIENT (Bank) + USERS&lt;br&gt;Client: goals, scope, priorities, budget.&lt;br&gt;Customers and admin staff: interviews → User Stories, rules for the mock data" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;fillColor=#F1F8E9;strokeColor=#558B2F;fontSize=11;" vertex="1" parent="1"><mxGeometry x="600" y="60" width="360" height="110" as="geometry"/></mxCell><mxCell id="c5" value="" style="endArrow=block;startArrow=block;html=1;strokeColor=#558B2F;strokeWidth=2;" edge="1" parent="1" source="c3" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Key risks of the current stage&lt;/b&gt;&lt;br&gt;R1 Scope creep: “everything competitors have” in 3 weeks&lt;br&gt;R2 Mock registries differ from the real passport / card data&lt;br&gt;R3 Real banking rules (licence, data law) not met in a launch" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;fillColor=#FFEBEE;strokeColor=#C62828;strokeWidth=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="180" width="460" height="90" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;2. Design&lt;/b&gt;&lt;br&gt;Use Case and ER diagrams (customers, cards, transactions), REST API contract, design of mock registries, wireframes → clickable prototype" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="60" y="320" width="460" height="110" as="geometry"/></mxCell><mxCell id="c8" value="USERS + DEVELOPER&lt;br&gt;Users: wireframe tests (5 customers, 1 admin).&lt;br&gt;Developer: data model, API contract, format of mock data.&lt;br&gt;Client: approves prototype" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;fillColor=#F1F8E9;strokeColor=#558B2F;fontSize=11;" vertex="1" parent="1"><mxGeometry x="600" y="320" width="360" height="110" as="geometry"/></mxCell><mxCell id="c9" value="" style="endArrow=block;startArrow=block;html=1;strokeColor=#558B2F;strokeWidth=2;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;3. Development&lt;/b&gt;&lt;br&gt;2-week Sprints: FastAPI backend, React web app, PostgreSQL, mock Passport / Card / SMS services, OTP logic, CI on GitHub" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="60" y="470" width="460" height="110" as="geometry"/></mxCell><mxCell id="c11" value="PRODUCT OWNER + TESTER&lt;br&gt;PO: daily clarifications, Sprint Review demo.&lt;br&gt;Tester: pull-request review, bug triage.&lt;br&gt;Client: sees demo every 2 weeks" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;fillColor=#F1F8E9;strokeColor=#558B2F;fontSize=11;" vertex="1" parent="1"><mxGeometry x="600" y="470" width="360" height="110" as="geometry"/></mxCell><mxCell id="c12" value="" style="endArrow=block;startArrow=block;html=1;strokeColor=#558B2F;strokeWidth=2;" edge="1" parent="1" source="c10" target="c11"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;4. Testing&lt;/b&gt;&lt;br&gt;Unit and API tests (pytest), UI tests (Playwright), concurrency and load tests, security scan (OWASP ZAP), UAT with test customers and an admin" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="60" y="620" width="460" height="110" as="geometry"/></mxCell><mxCell id="c14" value="TESTER + USERS + CLIENT&lt;br&gt;Tester ↔ Developer: bug reports, regression.&lt;br&gt;Test customers and admin: UAT sessions.&lt;br&gt;Client: signs acceptance" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;fillColor=#F1F8E9;strokeColor=#558B2F;fontSize=11;" vertex="1" parent="1"><mxGeometry x="600" y="620" width="360" height="110" as="geometry"/></mxCell><mxCell id="c15" value="" style="endArrow=block;startArrow=block;html=1;strokeColor=#558B2F;strokeWidth=2;" edge="1" parent="1" source="c13" target="c14"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;5. Deployment&lt;/b&gt;&lt;br&gt;Docker containers on a server located in Uzbekistan, CI/CD staging → production, DB migration with seed data (mock registries), admin guide" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="60" y="770" width="460" height="110" as="geometry"/></mxCell><mxCell id="c17" value="CLIENT IT + ADMIN&lt;br&gt;Client IT: server, domain, access rights.&lt;br&gt;Admin: short training, user guide.&lt;br&gt;Customers: pilot invitation" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;fillColor=#F1F8E9;strokeColor=#558B2F;fontSize=11;" vertex="1" parent="1"><mxGeometry x="600" y="770" width="360" height="110" as="geometry"/></mxCell><mxCell id="c18" value="" style="endArrow=block;startArrow=block;html=1;strokeColor=#558B2F;strokeWidth=2;" edge="1" parent="1" source="c16" target="c17"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;6. Maintenance / monitoring&lt;/b&gt;&lt;br&gt;Uptime and error monitoring, backups, hotfixes, new features from the backlog (e.g. adapters for the real registries), KPI report" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="60" y="920" width="460" height="110" as="geometry"/></mxCell><mxCell id="c20" value="USERS + CLIENT&lt;br&gt;Users → support: feedback, incidents.&lt;br&gt;Client ↔ PO: KPI report (digital share, transfer errors), change requests" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=8;fillColor=#F1F8E9;strokeColor=#558B2F;fontSize=11;" vertex="1" parent="1"><mxGeometry x="600" y="920" width="360" height="110" as="geometry"/></mxCell><mxCell id="c21" value="" style="endArrow=block;startArrow=block;html=1;strokeColor=#558B2F;strokeWidth=2;" edge="1" parent="1" source="c19" target="c20"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c22" value="" style="endArrow=block;html=1;strokeWidth=2;" edge="1" parent="1" source="c3" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c23" value="" style="endArrow=block;html=1;strokeWidth=2;" edge="1" parent="1" source="c7" target="c10"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c24" value="" style="endArrow=block;html=1;strokeWidth=2;" edge="1" parent="1" source="c10" target="c13"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c25" value="" style="endArrow=block;html=1;strokeWidth=2;" edge="1" parent="1" source="c13" target="c16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c26" value="" style="endArrow=block;html=1;strokeWidth=2;" edge="1" parent="1" source="c16" target="c19"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="c27" value="feedback loop: new requirements / change requests (every Sprint)" style="endArrow=block;html=1;strokeColor=#6A1B9A;strokeWidth=2;edgeStyle=orthogonalEdgeStyle;exitX=0;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="c19" target="c3"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>